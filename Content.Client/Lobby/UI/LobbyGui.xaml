<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:malinov="clr-namespace:Content.Client._MalinovStation.Lobby">
    <!-- Malinov-Edit: the vanilla split layout is replaced by a tile grid (MalinovLobbyTileUIController).
         Controls that vanilla code still reads keep their names and wait in LegacyPool until a tile adopts them;
         the rest of the lobby lives in the tiles under _MalinovStation/Lobby/Tiles. -->
    <!-- Background; a new picture fades in over the old one -->
    <malinov:MalinovLobbyBackground Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background" />
    <Control Name="MainContainer" Margin="10 10 10 10">
        <!-- Lobby tiles; a window narrower than the board scrolls sideways -->
        <ScrollContainer Name="TileHost" Access="Public">
            <malinov:MalinovLobbyTileGrid Name="TileGrid" Access="Public" />
        </ScrollContainer>
        <!-- Character setup state -->
        <!-- This is injected on startup. Funky! -->
        <Control Access="Public" Visible="False" Name="CharacterSetupState" />
        <!-- Voting Popups -->
        <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                      Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Control>
    <!-- Legacy lobby controls, adopted by lobby tiles -->
    <Control Name="LegacyPool" Access="Public" Visible="False">
        <!-- AHelpUIController reads AHelpButton; this file wires OptionsButton and LeaveButton.
             The buttons wrap, so the layout editing buttons fit a narrow tile. -->
        <WrapContainer Name="ActionsTileContent" Access="Public" Justification="Center"
                       SeparationOverride="4" CrossSeparationOverride="4"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                    StyleClasses="ButtonBig" />
            <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="ButtonBig" />
            <Button Name="OptionsButton" Access="Public" StyleClasses="ButtonBig"
                    Text="{Loc 'ui-lobby-options-button'}" />
            <Button Name="LeaveButton" Access="Public" StyleClasses="ButtonBig"
                    Text="{Loc 'ui-lobby-leave-button'}" />
            <!-- MalinovLobbyTileUIController switches layout editing with these. -->
            <Button Name="CustomizeButton" Access="Public" StyleClasses="ButtonBig"
                    Text="{Loc 'malinov-lobby-customize-button'}" />
            <controls:ConfirmButton Name="ResetLayoutButton" Access="Public" StyleClasses="ButtonBig" Visible="False"
                                    Text="{Loc 'malinov-lobby-reset-layout-button'}"
                                    ConfirmationText="{Loc 'malinov-lobby-reset-layout-confirm'}" />
        </WrapContainer>
        <!-- LobbyUIController reads CharacterPreview. -->
        <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />
        <!-- The chat controller finds the chat through this screen's widget registry, filled when the screen is built. -->
        <widgets:ChatBox Name="Chat" Access="Public" MinHeight="50" />
    </Control>
</lobbyUi:LobbyGui>
