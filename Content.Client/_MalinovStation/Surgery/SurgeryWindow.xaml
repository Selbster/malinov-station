<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc surgery-window-title}"
               SetSize="520 420"
               MinSize="420 320">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <ScrollContainer Name="SurgeryScroller" HorizontalExpand="True" VerticalExpand="True" SetWidth="220">
            <BoxContainer Name="SurgeryList" Orientation="Vertical" HorizontalExpand="True" Margin="4 4 4 4">
                <!-- Filled by code -->
            </BoxContainer>
        </ScrollContainer>
        <PanelContainer StyleClasses="LowDivider" />
        <ScrollContainer Name="StepScroller" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="StepList" Orientation="Vertical" HorizontalExpand="True" Margin="4 4 4 4">
                <!-- Filled by code -->
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
