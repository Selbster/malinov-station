<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
               xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc surgery-window-title}"
               SetSize="360 440"
               MinSize="300 340">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 6">
            <Button Name="PartsButton" Text="{Loc surgery-window-tab-parts}"
                    HorizontalExpand="True" StyleClasses="OpenBoth" />
            <Button Name="SurgeriesButton" Text="{Loc surgery-window-tab-surgeries}"
                    HorizontalExpand="True" StyleClasses="OpenBoth" />
            <Button Name="StepsButton" Text="{Loc surgery-window-tab-steps}"
                    HorizontalExpand="True" StyleClasses="OpenBoth" />
        </BoxContainer>
        <cc:HSeparator />
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="PartList" Orientation="Vertical" HorizontalExpand="True"
                          Margin="4 6 4 6" Visible="False">
                <!-- Filled by code -->
            </BoxContainer>
            <BoxContainer Name="SurgeryList" Orientation="Vertical" HorizontalExpand="True"
                          Margin="4 6 4 6" Visible="False">
                <!-- Filled by code -->
            </BoxContainer>
            <BoxContainer Name="StepList" Orientation="Vertical" HorizontalExpand="True"
                          Margin="4 6 4 6" Visible="False">
                <!-- Filled by code -->
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
    <PanelContainer Name="DisabledPanel" HorizontalExpand="True" VerticalExpand="True" Visible="False">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#000000BF" />
        </PanelContainer.PanelOverride>
        <RichTextLabel Name="DisabledLabel" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </PanelContainer>
</controls:FancyWindow>
