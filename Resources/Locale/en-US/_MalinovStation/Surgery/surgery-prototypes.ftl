# Steps

surgery-step-incision-name = Make Incision
surgery-step-incision-desc = Cut open the skin with a scalpel.
surgery-step-incision-popup = { CAPITALIZE(THE($user)) } makes an incision in { THE($target) }.

surgery-step-sternotomy-name = Saw Through Ribcage
surgery-step-sternotomy-desc = Cut through the ribcage with a saw to reach the chest cavity.
surgery-step-sternotomy-popup = { CAPITALIZE(THE($user)) } saws through { THE($target) }'s ribcage.

surgery-step-retraction-name = Retract Incision
surgery-step-retraction-desc = Hold the incision open with a retractor.

surgery-step-clamp-bleeders-name = Clamp Bleeders
surgery-step-clamp-bleeders-desc = Clamp the bleeding vessels shut with a hemostat.

surgery-step-extract-organ-name = Extract Organ
surgery-step-extract-organ-desc = Carefully remove the organ.
surgery-step-extract-organ-popup = { CAPITALIZE(THE($user)) } removes an organ from { THE($target) }.

surgery-step-insert-organ-name = Insert Organ
surgery-step-insert-organ-desc = Carefully place the organ into the cavity.
surgery-step-insert-organ-popup = { CAPITALIZE(THE($user)) } places an organ into { THE($target) }.

surgery-step-cauterize-name = Cauterize Incision
surgery-step-cauterize-desc = Seal the incision shut with a cautery.
surgery-step-cauterize-popup = { CAPITALIZE(THE($user)) } cauterizes the incision.

# Heart

surgery-heart-extraction-name = Heart — Extraction
surgery-heart-extraction-desc = Removes the patient's heart through their ribcage.
surgery-heart-installation-name = Heart — Installation
surgery-heart-installation-desc = Installs a heart into the patient's chest.

